#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Push Hook for huz4f.com
# Secondary defense: blocks pushing to remote if verification checks fail
# ==============================================================================

set -e

echo ""
echo "🚀 [Git Pre-Push] Running huz4f.com quality, SEO & AEO verification gate..."
echo "------------------------------------------------------------------------"

if ! command -v python3 &> /dev/null; then
    echo "⚠️  Python3 is required to run verification checks. Skipping."
    exit 0
fi

python3 scripts/verify_site.py

STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo ""
    echo "❌ [Git Pre-Push] Push rejected: Verification checks failed."
    echo "   Fix the issues before pushing to remote."
    echo "   To bypass in an emergency, use 'git push --no-verify'."
    echo ""
    exit 1
fi

echo ""
echo "✅ [Git Pre-Push] Verification succeeded! Pushing to remote."
echo ""
exit 0
